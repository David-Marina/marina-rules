  "python": {
   "resolve": "marina_rules.contract.resolve(rule, trade_date, scope, market, context, min_verification, as_of=None, require_tracked=False)",
   "coverage": "marina_rules.coverage(market, scope, rules, start, end, as_of=None, contract=None, require_tracked=False)",
   "tracked_through": "marina_rules.tracked_through(market, scope=None)",
   "rules_for": "marina_rules.rules_for(scope, market=None) — rule names a scope has, with intervals",
   "statutory_fee_floor": "marina_rules.statutory_fee_floor(turnover, side, date, market=None); statutory_fee_components(...) for the per-rule amounts and record ids",
   "skill_text": "marina_rules.skill_text() — the usage notes shipped with the package",
   "cli": "marina-rules | python -m marina_rules: query, rules, scopes, fees, check, adapt, mcp, capabilities, schema, skill, version",
   "limit_price": "marina_rules.limit_price(prev_close, scope, date, market, as_of=None)",
   "diff": "python -m marina_rules.diff <from_tag> <to_tag>",
   "check": "python -m marina_rules.check fills.csv",
   "adapt": "marina-rules adapt trades.csv --format NAME [--bars FILE --bars-format NAME] — an engine's trade export as checker rows; marina_rules.adapt.adapt_rows(...) in process"
  },
  "statuses": [
   "DETERMINED",
   "MISSING_CONTEXT",
   "OUT_OF_COVERAGE",
   "CONFLICT",
   "UNVERIFIED",
   "NOT_YET_PUBLISHED",
   "UNKNOWN_PUBLICATION",
   "BEYOND_TRACKING"
  ],
  "as_of": "optional ISO date on record_at/rule_at/coverage/resolve/limit_price/tick_size: answer only from rules with published_at <= as_of; published later → NOT_YET_PUBLISHED, published_at null → UNKNOWN_PUBLICATION; never falls back to an older record",
  "decision_schema": "python -m marina_rules.contract --schema",
  "tracking": "every decision carries tracking {tracked_through, beyond}; a DETERMINED answer from an open-ended record after tracked_through warns CARRY_FORWARD_BEYOND_TRACKED (untracked market: CARRY_FORWARD_UNTRACKED) — a carry-forward, not a finding; require_tracked=True refuses it as BEYOND_TRACKING (record_at / rule_at raise BeyondTracking)"
 },
 "preflight": [
  "pass dates as ISO 'YYYY-MM-DD' strings or date / datetime objects; any other spelling (20200102, 2020/1/2, an int) raises ValueError — it is refused, never guessed",
  "coverage() over the whole window before any computation",
  "supply every key in scope.requires per security per day; Marina never infers them",
  "stop on any status other than DETERMINED; cite known_gap_ids when present",
  "on OUT_OF_COVERAGE read alternatives: the scope may hold the rule under another name (scope_rules, similar_rules) or on another market code (markets) — a different name is a different rule, check its definition",
  "when tracking.beyond is true or warnings is not empty, say the answer is carried forward beyond the date the sources were checked, or pass require_tracked=True",
  "put citation() into every result"
 ],
